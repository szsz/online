# Deployment configuration — copy to .env and fill in your values.
# This file should NOT be committed to the repository.

# File storage server (viewer) — serves files, viewer UI
FILE_STORAGE_URL=https://viewer.example.com:6934

# Editor app — serves WASM assets, cool.html
EDITOR_URL=https://editor.example.com:6932

# Relay server — WebSocket message ordering
RELAY_URL=wss://relay.example.com:9091
