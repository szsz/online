# Deployment configuration — copy to .env and fill in your values.
# This file should NOT be committed to the repository.

# ── URLs (used by tests and by the servers when they inject /config) ─
# File storage server (viewer) — serves files, viewer UI
FILE_STORAGE_URL=https://viewer.example.com:6934

# Editor app — serves WASM assets, cool.html
EDITOR_URL=https://editor.example.com:6932

# Relay server — WebSocket message ordering
RELAY_URL=wss://relay.example.com:9091

# ── Storage backend selection (used by viewer-server.js) ─────────────
# local = filesystem under LOCAL_STORAGE_DIR (default ./storage)
# azure = Azure Blob, requires DOC_STORAGE_ACCOUNT below — auth via
#         DefaultAzureCredential (App Service MSI on Azure, `az login`
#         credentials locally). NO key/SAS in this file.
STORAGE_BACKEND=local

# Local backend: path where uploaded files are kept (any writable dir).
# LOCAL_STORAGE_DIR=/tmp/viewer-deploy/.files

# Azure backend: only required when STORAGE_BACKEND=azure
# DOC_STORAGE_ACCOUNT=coolwasmfiles
# DOC_STORAGE_CONTAINER=userdata

# ── On-host viewer settings (used by wasm/launch-viewer.sh) ──────────
# When the viewer is running directly on a host (not behind an HTTPS
# terminating reverse proxy / cloud platform), set these so it serves
# its own TLS. When running on Azure App Services, leave them unset —
# the platform terminates TLS and routes plain HTTP to the container.
PORT=6934
# SSL_CERT=/etc/letsencrypt/live/<host>/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/<host>/privkey.pem

# ── Viewer → editor pointer (used by wasm/viewer-server.js) ──────────
# Each editor deploy lives under ${EDITOR_URL}/<editor_deploy_id>/. The
# viewer reads this small JSON file at startup AND hot-reloads it via
# fs.watch so an operator-initiated pointer flip (via wasm/promote-editor.sh)
# takes effect without restarting the viewer.
#
# File contents:
#   { "editor_deploy_id": "2026-05-11-085500" }   # prod
#   { "editor_deploy_id": "" }                    # local dev (flat editor)
#
# An empty editor_deploy_id keeps the legacy flat-path behavior — viewer
# iframe URLs are constructed as ${EDITOR}/browser/cool.html (no prefix).
# In production deployments, this MUST be set to a real deploy id; the
# launcher refuses to start without the file.
#
# Conventional path: ~/ENV/viewer-config.json (alongside online-ci.env
# and online-staging-deploy.env). Each viewer host has its own — that
# decouples viewer-A pointing at editor build X from viewer-B pointing
# at editor build Y.
VIEWER_CONFIG_FILE=~/ENV/viewer-config.json
