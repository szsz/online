# Staging-Azure deployment config — copy to ~/ENV/online-staging-deploy.env
# (out-of-repo, gitignored) and fill in any values that differ from
# defaults. This is the env CI uses on push to `dev` (and that
# wasm/deploy-azure.sh defaults to when ENV_FILE is unset) — it
# targets the szebeni-wasm-{viewer,relay,static} App Services. Use
# /test-deploy or wasm/deploy-internal.sh to deploy elsewhere
# without disturbing this tier.
#
# The script uses whatever identity `az` CLI is logged in as — run
# `az login` once on the workstation, or have the CI runner log in
# (service principal / managed identity) before invoking the script.

# Optional — pin a subscription. Leave empty to use the CLI's active one.
AZURE_SUBSCRIPTION=

# ── Azure resource layout ────────────────────────────────────────────
RESOURCE_GROUP=Szilveszter-coediting
APP_SERVICE_PLAN=szebeni-wasm-plan

# App Service names — viewer + relay only. The editor lives on
# Azure Front Door / Storage (see wasm/deploy-front-door.sh and
# wasm/.env.deploy.frontdoor.example). The editor App Service was
# decommissioned 2026-05-12 alongside the SW-bridge cutover.
VIEWER_APP_NAME=szebeni-wasm-viewer
RELAY_APP_NAME=szebeni-wasm-relay

# ── Public URLs assigned to those App Services ──────────────────────
# EDITOR_URL is the Front Door endpoint (NOT an App Service URL).
VIEWER_URL=https://szebeni-wasm-viewer.azurewebsites.net
RELAY_URL=wss://szebeni-wasm-relay.azurewebsites.net
EDITOR_URL=https://wasmeditor-<your-fd-endpoint>.azurefd.net

# ── Azure Blob Storage (used by viewer when STORAGE_BACKEND=azure) ──
# Auth via App Service MSI / DefaultAzureCredential — NO key needed.
# The viewer App Service's identity must have "Storage Blob Data
# Contributor" on $DOC_STORAGE_ACCOUNT.
DOC_STORAGE_ACCOUNT=coolwasmfiles
DOC_STORAGE_CONTAINER=userdata

# ── Local staging directories used during deploy ────────────────────
VIEWER_DEPLOY_DIR=/tmp/viewer-deploy-azure
RELAY_DEPLOY_DIR=/tmp/relay-deploy-azure
