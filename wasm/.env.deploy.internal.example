# Internal-Azure deployment config — copy to ~/ENV/online-internal-deploy.env
# (out-of-repo, gitignored) and fill in any values that differ from
# defaults. Used by wasm/deploy-internal.sh, which sources this file and
# re-invokes wasm/deploy-azure.sh against the internal App Services.
#
# This is the second-tier env between local (viewer.szebeni.hu, dev box)
# and prod (szebeni-wasm-viewer.azurewebsites.net) — useful for staging
# changes against a real Azure deployment without touching prod.

# Optional — pin a subscription. Leave empty to use the CLI's active one.
AZURE_SUBSCRIPTION=

# ── Azure resource layout ────────────────────────────────────────────
RESOURCE_GROUP=Szilveszter-coediting
APP_SERVICE_PLAN=szebeni-wasm-plan

# App Service names — viewer + relay only. The editor lives on
# Azure Front Door / Storage (see wasm/deploy-front-door.sh).
VIEWER_APP_NAME=wasm-viewer-internal
RELAY_APP_NAME=wasm-relay-internal

# ── Public URLs assigned to those App Services ──────────────────────
# EDITOR_URL is the Front Door endpoint (NOT an App Service URL).
VIEWER_URL=https://wasm-viewer-internal.azurewebsites.net
RELAY_URL=wss://wasm-relay-internal.azurewebsites.net
EDITOR_URL=https://wasmeditor-<your-fd-endpoint>.azurefd.net

# ── Azure Blob Storage (used by viewer when STORAGE_BACKEND=azure) ──
# Auth via App Service MSI / DefaultAzureCredential — NO key needed.
# The viewer App Service's MSI must have "Storage Blob Data Contributor"
# on $DOC_STORAGE_ACCOUNT.
#
# Internal uses a SEPARATE storage account (coolwasmfilesinternal) so
# internal experiments / migrations can't damage prod userdata. Same
# container name 'userdata' inside it for code symmetry.
DOC_STORAGE_ACCOUNT=coolwasmfilesinternal
DOC_STORAGE_CONTAINER=userdata

# ── Local staging directories used during deploy ────────────────────
VIEWER_DEPLOY_DIR=/tmp/viewer-deploy-azure-internal
RELAY_DEPLOY_DIR=/tmp/relay-deploy-azure-internal
