# Test-Azure deployment config — copy to ~/ENV/online-test-deploy.env
# (out-of-repo, gitignored) and fill in any values that differ from
# defaults. Used by wasm/deploy-test.sh, which sources this file and
# re-invokes wasm/deploy-azure.sh against the test App Services.
#
# Test is the throwaway tier between local/internal/prod — useful for
# validating a build or config change against real Azure without
# touching internal or prod.

# Optional — pin a subscription. Leave empty to use the CLI's active one.
AZURE_SUBSCRIPTION=

# ── Azure resource layout ────────────────────────────────────────────
RESOURCE_GROUP=Szilveszter-coediting
APP_SERVICE_PLAN=szebeni-wasm-plan

# Three App Service names. Must be globally unique on Azure — these
# are separate App Services from internal (wasm-{viewer,static,relay}-internal)
# and prod (szebeni-wasm-{viewer,static,relay}). The first deploy
# creates them via `az webapp create`.
VIEWER_APP_NAME=wasm-viewer-test
RELAY_APP_NAME=wasm-relay-test
EDITOR_APP_NAME=wasm-static-test

# ── Public URLs assigned to those App Services ──────────────────────
VIEWER_URL=https://wasm-viewer-test.azurewebsites.net
RELAY_URL=wss://wasm-relay-test.azurewebsites.net
EDITOR_URL=https://wasm-static-test.azurewebsites.net

# ── Azure Blob Storage (used by viewer when STORAGE_BACKEND=azure) ──
# Auth via App Service MSI / DefaultAzureCredential — NO key needed.
# The viewer App Service's MSI must have "Storage Blob Data Contributor"
# on $DOC_STORAGE_ACCOUNT before the first v2 upload will work.
#
# Test uses a SEPARATE storage account (coolwasmfilestest) so test
# experiments / migrations can't damage internal/prod userdata.
DOC_STORAGE_ACCOUNT=coolwasmfilestest
DOC_STORAGE_CONTAINER=userdata

# ── Local staging directories used during deploy (any writable dir) ─
# Distinct from prod's /tmp/{viewer,relay,editor}-deploy-azure and
# internal's /tmp/{...}-internal so concurrent deploys can't clobber.
VIEWER_DEPLOY_DIR=/tmp/viewer-deploy-azure-test
RELAY_DEPLOY_DIR=/tmp/relay-deploy-azure-test
EDITOR_DEPLOY_DIR=/tmp/editor-deploy-azure-test
